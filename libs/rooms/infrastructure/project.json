{
  "name": "rooms-infrastructure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/rooms/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:rooms", "type:infrastructure", "platform:server"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/rooms/infrastructure",
        "main": "libs/rooms/infrastructure/src/index.ts",
        "tsConfig": "libs/rooms/infrastructure/tsconfig.lib.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/rooms/infrastructure/tsconfig.lib.json --noEmit --rootDir ."
      }
    }
  }
}
