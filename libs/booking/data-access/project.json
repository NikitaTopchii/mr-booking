{
  "name": "booking-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/booking/data-access/src",
  "projectType": "library",
  "tags": ["scope:booking", "type:data-access", "platform:api"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/booking/data-access",
        "main": "libs/booking/data-access/src/index.ts",
        "tsConfig": "libs/booking/data-access/tsconfig.lib.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/booking/data-access/tsconfig.lib.json --noEmit"
      }
    }
  }
}
