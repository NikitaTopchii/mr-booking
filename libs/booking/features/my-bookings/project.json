{
  "name": "booking-feature-my-bookings",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/booking/features/my-bookings/src",
  "projectType": "library",
  "tags": ["scope:booking", "type:feature", "platform:web"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/booking/features/my-bookings/tsconfig.lib.json --noEmit --rootDir ."
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/booking/features/my-bookings",
        "main": "libs/booking/features/my-bookings/src/index.ts",
        "tsConfig": "libs/booking/features/my-bookings/tsconfig.lib.json",
        "assets": []
      }
    }
  }
}
