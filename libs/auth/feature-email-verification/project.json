{
  "name": "auth-feature-email-verification",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth/feature-email-verification/src",
  "projectType": "library",
  "tags": ["scope:auth", "type:feature", "platform:web"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/auth/feature-email-verification",
        "main": "libs/auth/feature-email-verification/src/index.ts",
        "tsConfig": "libs/auth/feature-email-verification/tsconfig.lib.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/auth/feature-email-verification/tsconfig.lib.json --noEmit --rootDir ."
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/libs/auth/feature-email-verification"
      ],
      "options": {
        "jestConfig": "libs/auth/feature-email-verification/jest.config.cts",
        "passWithNoTests": false
      }
    }
  }
}
