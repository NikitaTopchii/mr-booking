{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "useUnknownInCatchVariables": true,
    "paths": {
      "@mr-booking/shared-config": ["./libs/shared/config/src/index.ts"],
      "@mr-booking/shared-config/node": ["./libs/shared/config/src/node.ts"],
      "@mr-booking/shared-database": ["./libs/shared/database/src/index.ts"],
      "@mr-booking/rooms-data-access": ["./libs/rooms/data-access/src/index.ts"]
    }
  }
}
