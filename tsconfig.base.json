{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "useUnknownInCatchVariables": true,
    "paths": {
      "@mr-booking/shared-config": ["./libs/shared/config/src/index.ts"],
      "@mr-booking/shared-config/node": ["./libs/shared/config/src/node.ts"],
      "@mr-booking/shared-date-time": [
        "./libs/shared/agnostic/date-time/src/index.ts"
      ],
      "@mr-booking/shared-database": [
        "./libs/shared/server/database/src/index.ts"
      ],
      "@mr-booking/shared-ui": ["./libs/shared/web/ui/src/index.ts"],
      "@mr-booking/shared-i18n": ["./libs/shared/web/i18n/src/index.ts"],
      "@mr-booking/shared-error-handling": [
        "./libs/shared/agnostic/error-handling/src/index.ts"
      ],
      "@mr-booking/shared-i18n/server": [
        "./libs/shared/web/i18n/src/server.ts"
      ],
      "@mr-booking/booking-domain": ["./libs/booking/domain/src/index.ts"],
      "@mr-booking/booking-infrastructure": [
        "./libs/booking/server/infrastructure/src/index.ts"
      ],
      "@mr-booking/booking-infrastructure/schema": [
        "./libs/booking/server/infrastructure/src/schema.ts"
      ],
      "@mr-booking/booking-data-access": [
        "./libs/booking/server/data-access/src/index.ts"
      ],
      "@mr-booking/booking-data-access/seed": [
        "./libs/booking/server/data-access/src/seed.ts"
      ],
      "@mr-booking/booking-application": [
        "./libs/booking/server/application/src/index.ts"
      ],
      "@mr-booking/booking-data-access-web": [
        "./libs/booking/web/data-access/src/index.ts"
      ],
      "@mr-booking/booking-ui": ["./libs/booking/web/ui/src/index.ts"],
      "@mr-booking/booking-feature-schedule": [
        "./libs/booking/web/features/schedule/src/index.ts"
      ],
      "@mr-booking/booking-feature-my-bookings": [
