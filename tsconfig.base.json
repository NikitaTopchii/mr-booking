      ],
      "@mr-booking/rooms-data-access": [
        "./libs/rooms/server/data-access/src/index.ts"
      ],
      "@mr-booking/rooms-domain": ["./libs/rooms/domain/src/index.ts"],
      "@mr-booking/rooms-infrastructure": [
        "./libs/rooms/server/infrastructure/src/index.ts"
      ],
      "@mr-booking/rooms-infrastructure/schema": [
        "./libs/rooms/server/infrastructure/src/schema.ts"
      ],
      "@mr-booking/auth-domain": ["./libs/auth/domain/src/index.ts"],
      "@mr-booking/auth-data-access": [
        "./libs/auth/server/data-access/src/index.ts"
      ],
      "@mr-booking/auth-infrastructure": [
        "./libs/auth/server/infrastructure/src/index.ts"
      ],
      "@mr-booking/auth-infrastructure/schema": [
        "./libs/auth/server/infrastructure/src/schema.ts"
