{
  "name": "mr-booking",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx --tsconfig tools/tsconfig.json tools/scripts/development.ts",
    "start": "tsx --tsconfig tools/tsconfig.json tools/scripts/compose.ts up",
    "stop": "tsx --tsconfig tools/tsconfig.json tools/scripts/compose.ts down",
    "reset": "tsx --tsconfig tools/tsconfig.json tools/scripts/compose.ts reset",
    "logs": "tsx --tsconfig tools/tsconfig.json tools/scripts/compose.ts logs",
    "test": "node tools/scripts/run-nx-target.mjs test",
    "lint": "node tools/scripts/run-nx-target.mjs lint",
    "typecheck": "node tools/scripts/run-nx-target.mjs typecheck",
    "build": "node tools/scripts/run-nx-target.mjs build",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tools/tsconfig.json tools/scripts/database.ts migrate",
    "db:seed": "tsx --tsconfig tools/tsconfig.json tools/scripts/database.ts seed",
    "verify:commit": "node tools/scripts/verify-commit.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@next/eslint-plugin-next": "16.2.12",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/next": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.46",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/parser": "8.65.0",
    "babel-jest": "30.4.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-environment-node": "30.4.1",
    "jest-util": "30.3.0",
    "jsonc-eslint-parser": "2.4.2",
    "nx": "23.1.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "webpack": "5.109.0",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "5.2.6"
  },
  "resolutions": {
    "axios": "1.18.1",
    "brace-expansion": "5.0.8"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/terminus": "11.1.1",
    "better-sqlite3": "13.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  }
}
